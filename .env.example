# Compose 项目名，用于隔离命名卷、网络与容器前缀
COMPOSE_PROJECT_NAME=biosample-cold-custody-tracking

# 对外端口
FRONTEND_PORT=18505
BACKEND_PORT=19505

# PostgreSQL
POSTGRES_DB=biosample_custody
POSTGRES_USER=biosample
POSTGRES_PASSWORD=biosample_dev_password

# MinIO 对象存储（协议附件）
MINIO_ROOT_USER=biosample-admin
MINIO_ROOT_PASSWORD=biosample-minio-password
MINIO_BUCKET=protocol-documents

# JWT 签名密钥，部署到共享环境前必须替换
JWT_SECRET=local-development-secret-change-me
